@Library('jenkins-shared-lib-demo@main') _
pipeline {
    agent any

    tools {
    maven 'Maven-3.8'
    jdk 'JDK-17'
}


    environment {
        AWS_CONFIG_FILE = '/var/lib/jenkins/.aws/config'
        NEXUS_CREDS = credentials('nexus-credentials')
        SERVICE_NAME = 'eureka'

    }  

    stages {

        stage('Load Configuration') {
            steps {
                script {
                    // Load configuration from config.yml
                    def config = envConfig()

                    env.NEXUS_URL= config.nexus.url
                    env.AWS_REGION = config.aws.region
                    env.EUREKA_PORT = config.eureka.defaultPort 
                    env.BASE_AMI_ID = config.baseAmi.ubuntu2204 
                    env.SERVICE_NAME = config.servicename.obj1

                    echo "Loaded configuration: NEXUS_URL=${env.NEXUS_URL}, AWS_REGION=${env.AWS_REGION}, EUREKA_PORT=${env.EUREKA_PORT}, BASE_AMI_ID=${env.BASE_AMI_ID}, SERVICE_NAME=${env.SERVICE_NAME}"
                    
                }
            }
        }
        stage('Set Version') {
            steps { 
                script {
                dir('eureka') {
                    env.SERVICE_VERSION = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                    echo "POM Running Version : ${env.SERVICE_VERSION}"
}
                }

            }
        }
        stage ('Maven Compile') {
            steps{
                dir('eureka') {
                   sh 'mvn compile' 

                }
            }
        }

        stage ('Sonar Analysis') {
            steps {
              dir('eureka') {
                withSonarQubeEnv('sonar') {
    sh """
        mvn sonar:sonar \
            -Dsonar.projectKey=com.ksapp:eureka \
            -Dsonar.projectName="Eureka_Service_Registry_v${env.SERVICE_VERSION}" \
            -Dsonar.projectVersion=${env.SERVICE_VERSION} \
            -Dsonar.sources=src/main/java \
            -Dsonar.java.binaries=target/classes

    """
}


              }  
            }
        }

           stage ('Maven Package') {
            steps{
                dir('eureka') {
                   sh 'mvn package' 

                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir('eureka') {
                    script {
                        def jarFile = "target/eureka-${env.SERVICE_VERSION}.jar"
                        def nexusPath = "${env.NEXUS_URL}/com/ksapp/eureka/${env.SERVICE_VERSION}/eureka-${env.SERVICE_VERSION}.jar"
                        
                        withCredentials([usernamePassword(credentialsId: 'nexus-credentials', 
                                                        usernameVariable: 'NEXUS_USER', 
                                                        passwordVariable: 'NEXUS_PASS')]) {
                            sh """
                                curl -f -u ${NEXUS_USER}:${NEXUS_PASS} --upload-file ${jarFile} ${nexusPath}
                            """
                        }
                    }
                }
            }
        }


        
        stage('Bake Golden Image') {
            steps {
                withEnv([
                    "SERVICE_VERSION=${env.SERVICE_VERSION}",
                    "SERVICE_NAME=${env.SERVICE_NAME}",
                    "NEXUS_URL=${env.NEXUS_URL}",
                    "EUREKA_PORT=${env.EUREKA_PORT}",
                    "BASE_AMI_ID=${env.BASE_AMI_ID}"
                    ]) {
                        dir('eureka/packer') {
                        sh '''
                            packer init eureka.pkr.hcl
                            packer build \
                                -var "service_version=${SERVICE_VERSION}" \
                                -var "service_name=${SERVICE_NAME}" \
                                -var "nexus_url=${NEXUS_URL}" \
                                -var "eureka_port=${EUREKA_PORT}" \
                                -var "source_ami=${BASE_AMI_ID}" \
                                eureka.pkr.hcl 2>&1 | tee build-output.txt
                            AMI_ID=$(grep -oE 'ami-[a-f0-9]{17}' build-output.txt | tail -1)
                            echo "GOLDEN_AMI_ID=$AMI_ID" > golden-ami.properties
                            '''
                        }
                    }
            }
        }

        }  

    

     







    //     stage('Build AMI') {
    //         steps {
    //             sh """
    //                 packer init packer/ami.pkr.hcl
    //                 packer validate packer/ami.pkr.hcl
    //                 packer build \
    //                     -var 'build_number=${BUILD_NUMBER}' \
    //                     packer/ami.pkr.hcl
    //             """
    //         }
    //     }
    //

    post {
        success {
            echo 'AMI build completed successfully!'                   
        }
        failure {
            echo 'AMI build failed. Check logs above.'
        }
    }
}
