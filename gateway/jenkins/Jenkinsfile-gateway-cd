@Library('jenkins-shared-lib-demo@main') _

pipeline {
    agent any

    parameters {
        string(name: 'AMI_ID', defaultValue: '', description: 'Gateway AMI ID')
        choice(name: 'ACTION', choices: ['apply', 'destroy'], description: 'Terraform action')
    }

    environment {
        AWS_CONFIG_FILE = '/var/lib/jenkins/.aws/config'  
        // Database credentials from shared library
        DB_USERNAME_CREDS = credentials('db-username')
        DB_PASSWORD = credentials('db-password')
    }

    stages {
        stage('Load Configuration') {
            steps {
                script {
                    def config = envConfig()
                    
                    env.AWS_DEFAULT_REGION = config.aws.region
                    env.NEXUS_URL = config.nexus.url
                    env.DB_URL = config.db.url
                    env.DB_HOST = config.db.host
                    env.DB_PORT = config.db.port
                    env.DB_NAME = config.db.name
                    env.SERVICE_NAME = 'gateway'
                    env.SERVICE_PORT = config.services.gateway.defaultPort
                    
                    // Get network configuration from shared library
                    env.VPC_ID = config.vpc?.id ?: "vpc-0cb7deb47a6bfa727"
                    env.SUBNET_ID = config.subnet?.id ?: "subnet-0aa31e769c8f4d73e"
                    env.KEY_NAME = config.key?.name ?: "ksansible"
                    
                    echo "=========================================="
                    echo "Gateway CD Pipeline"
                    echo "=========================================="
                    echo "Action: ${params.ACTION}"
                    echo "AWS Region: ${env.AWS_DEFAULT_REGION}"
                    echo "Service Port: ${env.SERVICE_PORT}"
                    echo "DB URL: ${env.DB_URL}"
                    echo "VPC ID: ${env.VPC_ID}"
                    echo "Subnet ID: ${env.SUBNET_ID}"
                    echo "Key Name: ${env.KEY_NAME}"
                    echo "=========================================="
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/kartikeyasoft/ExamApp.git', branch: 'main'
            }
        }

        stage('Get Service URLs from SSM') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    def service1Url = sh(script: """
                        aws ssm get-parameter \
                            --name "/exam/services/service1/url" \
                            --query 'Parameter.Value' \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!service1Url || service1Url == 'None' || service1Url == 'null' || service1Url == '') {
                        error "Service1 URL not found in SSM. Please run Service1 CD first."
                    }
                    
                    def service2Url = sh(script: """
                        aws ssm get-parameter \
                            --name "/exam/services/service2/url" \
                            --query 'Parameter.Value' \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!service2Url || service2Url == 'None' || service2Url == 'null' || service2Url == '') {
                        error "Service2 URL not found in SSM. Please run Service2 CD first."
                    }
                    
                    // Get Eureka URL from SSM
                    def eurekaIp = sh(script: """
                        aws ssm get-parameter \
                            --name "/exam/eureka/ip" \
                            --query 'Parameter.Value' \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!eurekaIp || eurekaIp == 'None' || eurekaIp == 'null' || eurekaIp == '') {
                        error "Eureka IP not found or is null in SSM. Please run Eureka CD first and wait for completion."
                    }
                    
                    env.EUREKA_URL = "http://${eurekaIp}:${env.EUREKA_PORT}/eureka/"
                    
                    echo "✅ Service1 URL from SSM: ${service1Url}"
                    echo "✅ Service2 URL from SSM: ${service2Url}"
                    echo "✅ Retrieved Eureka URL from SSM: ${env.EUREKA_URL}"
                    
                    env.SERVICE1_URL = service1Url
                    env.SERVICE2_URL = service2Url
                }
            }
        }

        stage('Get AMI ID') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    def amiId = params.AMI_ID
                    
                    if (!amiId || amiId == '') {
                        try {
                            unstash 'gateway-ami'
                            def amiProps = readFile('golden-ami.properties')
                            amiId = amiProps.split('=')[1].trim()
                            echo "✅ Retrieved AMI from CI: ${amiId}"
                        } catch (Exception e) {
                            echo "No AMI found in stash"
                        }
                    }
                    
                    if (!amiId || amiId == '') {
                        amiId = sh(script: """
                            aws ec2 describe-images \
                                --region ${env.AWS_DEFAULT_REGION} \
                                --owners self \
                                --filters "Name=name,Values=myapp-gateway-v*" \
                                --query 'Images | sort_by(@, &CreationDate) | [-1].ImageId' \
                                --output text
                        """, returnStdout: true).trim()
                        echo "✅ Found latest AMI from AWS: ${amiId}"
                    }
                    
                    if (!amiId || amiId == '') {
                        error "No AMI ID found!"
                    }
                    
                    env.AMI_ID = amiId
                    echo "✅ Using AMI ID: ${env.AMI_ID}"
                }
            }
        }

        stage('Validate') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    if (!env.AMI_ID || env.AMI_ID == '') {
                        error "AMI_ID is required for apply action"
                    }
                    if (!env.SERVICE1_URL || env.SERVICE1_URL == '') {
                        error "SERVICE1_URL is required (should be in SSM)"
                    }
                    if (!env.SERVICE2_URL || env.SERVICE2_URL == '') {
                        error "SERVICE2_URL is required (should be in SSM)"
                    }
                    if (!env.EUREKA_URL || env.EUREKA_URL == '') {
                        error "EUREKA_URL is required for apply action"
                    }
                    echo "✅ Validation passed"
                    echo "   AMI ID: ${env.AMI_ID}"
                    echo "   Service1 URL: ${env.SERVICE1_URL}"
                    echo "   Service2 URL: ${env.SERVICE2_URL}"
                    echo "   Eureka URL: ${env.EUREKA_URL}"
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('gateway/terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir('gateway/terraform') {
                    sh """
                        terraform apply -auto-approve \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="service1_url=${env.SERVICE1_URL}" \
                            -var="service2_url=${env.SERVICE2_URL}" \
                            -var="db_url=${env.DB_URL}" \
                            -var="db_username=${DB_USERNAME_CREDS}" \
                            -var="db_password=${DB_PASSWORD}" \
                            -var="eureka_url=${env.EUREKA_URL}" \
                            -var="service_port=${env.SERVICE_PORT}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="key_name=${env.KEY_NAME}" \
                            -var="environment=production" \
                            -var="instance_type=t3.micro"
                    """
                }
            }
        }

        stage('Store Gateway Endpoint in SSM') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir('gateway/terraform') {
                        def gateway_ip = ""
                        try {
                            gateway_ip = sh(script: "terraform output -raw gateway_private_ip", returnStdout: true).trim()
                            echo "✅ Retrieved Gateway Private IP from Terraform: ${gateway_ip}"
                        } catch (Exception e) {
                            echo "⚠️ Could not get gateway_private_ip from terraform output"
                            gateway_ip = sh(script: """
                                aws ec2 describe-instances \
                                    --filters "Name=tag:Name,Values=gateway*" "Name=instance-state-name,Values=running" \
                                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                                    --region ${env.AWS_DEFAULT_REGION} \
                                    --output text
                            """, returnStdout: true).trim()
                            echo "⚠️ Using discovered Gateway IP: ${gateway_ip}"
                        }
                        
                        if (gateway_ip && gateway_ip != 'None' && gateway_ip != '' && gateway_ip != 'null') {
                            sh """
                                aws ssm put-parameter \
                                    --name "/exam/services/gateway/url" \
                                    --value "http://${gateway_ip}:${env.SERVICE_PORT}" \
                                    --type "String" \
                                    --overwrite \
                                    --region ${env.AWS_DEFAULT_REGION}
                            """
                            
                            def timestamp = sh(script: "date -u +%Y-%m-%dT%H:%M:%SZ", returnStdout: true).trim()
                            def gatewayEndpoint = """{"ip":"${gateway_ip}","port":"${env.SERVICE_PORT}","url":"http://${gateway_ip}:${env.SERVICE_PORT}","service":"gateway","updatedAt":"${timestamp}"}"""
                            
                            sh """
                                aws ssm put-parameter \
                                    --name "/exam/services/gateway" \
                                    --value '${gatewayEndpoint}' \
                                    --type "String" \
                                    --overwrite \
                                    --region ${env.AWS_DEFAULT_REGION}
                            """
                            
                            echo "=========================================="
                            echo "✅ Gateway Endpoint Stored in SSM"
                            echo "=========================================="
                            echo "Gateway IP: ${gateway_ip}"
                            echo "Gateway Port: ${env.SERVICE_PORT}"
                            echo "Gateway URL: http://${gateway_ip}:${env.SERVICE_PORT}"
                            echo "=========================================="
                        } else {
                            echo "⚠️ Could not determine Gateway IP, skipping SSM update"
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                script {
                    echo "🧹 Cleaning up SSM parameters for Gateway..."
                    sh """
                        aws ssm delete-parameter \
                            --name "/exam/services/gateway/url" \
                            --region ${env.AWS_DEFAULT_REGION} 2>/dev/null || true
                    """
                    sh """
                        aws ssm delete-parameter \
                            --name "/exam/services/gateway" \
                            --region ${env.AWS_DEFAULT_REGION} 2>/dev/null || true
                    """
                    echo "✅ SSM cleanup completed"
                }
                dir('gateway/terraform') {
                    sh """
                        terraform destroy -auto-approve \
                            -var="ami_id=ami-placeholder" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="service1_url=http://placeholder" \
                            -var="service2_url=http://placeholder" \
                            -var="db_url=jdbc:mysql://placeholder:3306/exam" \
                            -var="db_username=placeholder" \
                            -var="db_password=placeholder" \
                            -var="service_port=${env.SERVICE_PORT}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="eureka_url=${env.EUREKA_URL}" \
                            -var="key_name=${env.KEY_NAME}" \
                            -var="environment=production" \
                            -var="instance_type=t3.micro"
                    """
                }
            }
        }

        stage('Output') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir('gateway/terraform') {
                        def public_ip = sh(script: "terraform output -raw gateway_public_ip", returnStdout: true).trim()
                        def private_ip = sh(script: "terraform output -raw gateway_private_ip", returnStdout: true).trim()
                        
                        echo "=========================================="
                        echo "✅ Gateway Deployed Successfully!"
                        echo "=========================================="
                        echo "AMI ID: ${env.AMI_ID}"
                        echo "Public IP: ${public_ip}"
                        echo "Private IP: ${private_ip}"
                        echo "Service Port: ${env.SERVICE_PORT}"
                        echo "Gateway URL: http://${public_ip}:${env.SERVICE_PORT}"
                        echo "Internal URL: http://${private_ip}:${env.SERVICE_PORT}"
                        echo "Eureka URL: ${env.EUREKA_URL}"
                        echo "=========================================="
                        echo "Service Endpoints from SSM:"
                        echo "  Service1: ${env.SERVICE1_URL}"
                        echo "  Service2: ${env.SERVICE2_URL}"
                        echo "=========================================="
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                echo "✅ Gateway ${params.ACTION} completed successfully!"
                if (params.ACTION == 'apply') {
                    echo "🎯 Gateway is now routing requests to:"
                    echo "   - Service1: ${env.SERVICE1_URL}"
                    echo "   - Service2: ${env.SERVICE2_URL}"
                    echo "   - Eureka: ${env.EUREKA_URL}"
                }
            }
        }
        failure {
            script {
                echo "❌ Gateway ${params.ACTION} failed!"
                echo "Check the logs above for detailed error information"
            }
        }
    }
}